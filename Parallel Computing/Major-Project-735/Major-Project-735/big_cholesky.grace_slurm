#!/bin/bash
##ENVIRONMENT SETTINGS; CHANGE WITH CAUTION
#SBATCH --export=NONE                #Do not propagate environment
#SBATCH --get-user-env               #Replicate login environment
#
##NECESSARY JOB SPECIFICATIONS
#SBATCH --job-name=cholesky_factorization
#SBATCH --time=8:00:00               #Set the wall clock limit
#SBATCH --nodes=1                    #Request 1 node
#SBATCH --ntasks-per-node=1          #Request 1 tasks/cores per node
#SBATCH --cpus-per-task=1
#SBATCH --gres=gpu:a100:1            #Request 1 A100 GPU
#SBATCH --partition=gpu              #Request the GPU partition/queue
#SBATCH --mem=10G                    #Request 10GB per node 
#SBATCH --output=%j_big.output           #Send stdout/err to "[jobID].output" 
#
##OPTIONAL JOB SPECIFICATIONS
##SBATCH --mail-type=ALL              #Send email on all job events
##SBATCH --mail-user=ngarde2882@tamu.edu    #Send all emails to email_address 
#
module load intel CUDA
nvcc -arch=sm_80 -o cholesky_b.exe cholesky_d.cu
#           mat_size BlockXDim BlockYDim        blockx*blocky<=1024
# ./cholesky_b.exe <n> <blockx> <blocky>
# 1024 threads
./cholesky_b.exe 16384 32 32
./cholesky_b.exe 16384 64 16
./cholesky_b.exe 16384 16 64
./cholesky_b.exe 16384 128 8
./cholesky_b.exe 16384 8 128
./cholesky_b.exe 16384 256 4
./cholesky_b.exe 16384 4 256
# 512 threads
./cholesky_b.exe 16384 32 16
./cholesky_b.exe 16384 16 32
./cholesky_b.exe 16384 64 8
./cholesky_b.exe 16384 8 64
./cholesky_b.exe 16384 128 4
./cholesky_b.exe 16384 4 128
# 256 threads
./cholesky_b.exe 16384 16 16
./cholesky_b.exe 16384 32 8
./cholesky_b.exe 16384 8 32
./cholesky_b.exe 16384 64 4
./cholesky_b.exe 16384 4 64
# 128 threads
./cholesky_b.exe 16384 16 8
./cholesky_b.exe 16384 8 16
./cholesky_b.exe 16384 32 4
./cholesky_b.exe 16384 4 32
##
