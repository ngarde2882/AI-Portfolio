#!/bin/bash
##ENVIRONMENT SETTINGS; CHANGE WITH CAUTION
#SBATCH --export=NONE                #Do not propagate environment
#SBATCH --get-user-env               #Replicate login environment
#
##NECESSARY JOB SPECIFICATIONS
#SBATCH --job-name=strassen          #Set the job name
#SBATCH --time=3:00:00               #Set the wall clock limit
#SBATCH --nodes=1                    #Request 1 node
#SBATCH --ntasks-per-node=1          #Request 1 tasks/cores per node
#SBATCH --cpus-per-task=48
#SBATCH --mem=200G                   #Request 200GB per node 
#SBATCH --output=%j.output           #Send stdout/err to "[jobID].output" 
#
##OPTIONAL JOB SPECIFICATIONS
##SBATCH --mail-type=ALL              #Send email on all job events
##SBATCH --mail-user=ngarde2882    #Send all emails to email_address 
#
##First Executable Line
#
module load intel         # load Intel software stack 
export OMP_NUM_THREADS=48
#
# ./strass1.exe 14 5
# ./strass.exe 14 5
# ./strass1.exe 14 6
# ./strass.exe 14 6
# ./strass1.exe 14 7
# ./strass.exe 14 7
# ./strass1.exe 14 8
# ./strass.exe 14 8
./strass1.exe 14 9
./strass.exe 14 9
./strass1.exe 14 10
./strass.exe 14 10
./strass1.exe 14 11
./strass.exe 14 11
##
