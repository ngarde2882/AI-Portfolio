#!/bin/bash
##ENVIRONMENT SETTINGS; CHANGE WITH CAUTION
#SBATCH --export=NONE                #Do not propagate environment
#SBATCH --get-user-env               #Replicate login environment
#
##NECESSARY JOB SPECIFICATIONS
#SBATCH --job-name=hypercube_qsort_test
#SBATCH --time=0:05:00               #Set the wall clock limit
#SBATCH --nodes=1                    #Request 1 node
#SBATCH --ntasks-per-node=1          #Request 1 tasks/cores per node
#SBATCH --cpus-per-task=16
#SBATCH --mem=10G                   #Request 200GB per node 
#SBATCH --output=%j_j1.output           #Send stdout/err to "[jobID].output" 
#
##OPTIONAL JOB SPECIFICATIONS
##SBATCH --mail-type=ALL              #Send email on all job events
##SBATCH --mail-user=ngarde2882@tamu.edu    #Send all emails to email_address 
#
##First Executable Line
#
# module load intel         # load Intel software stack 
module load intel
mpiicpx -o qsort_hypercube.exe qsort_hypercube.cpp
#           processes          local list sz    list init method
# mpirun -np <p> ./qsort_hypercube.exe <n> <type>
mpirun -np 2 ./qsort_hypercube.exe 4 -1
mpirun -np 4 ./qsort_hypercube.exe 4 -2
mpirun -np 8 ./qsort_hypercube.exe 4 -1
mpirun -np 16 ./qsort_hypercube.exe 4 0
mpirun -np 16 ./qsort_hypercube.exe 20480000 0
##
