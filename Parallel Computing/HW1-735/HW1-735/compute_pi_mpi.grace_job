#!/bin/bash
##ENVIRONMENT SETTINGS; CHANGE WITH CAUTION
#SBATCH --export=NONE            #Do not propagate environment
#SBATCH --get-user-env         #Replicate login environment
#
##NECESSARY JOB SPECIFICATIONS
#SBATCH --job-name=JobName       #Set the job name to "JobName"
#SBATCH --time=0:30:00           #Set the wall clock limit to 0hr and 30min
#SBATCH --nodes=16               #Request 16 node
#SBATCH --ntasks-per-node=8      #Request -4- 8 tasks/cores per node
#SBATCH --mem=8G                 #Request 8GB per node 
#SBATCH --output=output.%j       #Send stdout/err to "output.[jobID]" 
#
##OPTIONAL JOB SPECIFICATIONS
##SBATCH --mail-type=ALL              #Send email on all job events
##SBATCH --mail-user=email_address    #Send all emails to email_address 
#
##First Executable Line
#
module load intel             # load Intel software stack 
#
echo "Processes = 1"
mpirun -ppn 4 -np  1 ./compute_pi_mpi.exe 100000000
echo "Processes = 2"
mpirun -ppn 4 -np  2 ./compute_pi_mpi.exe 100000000
echo "Processes = 4"
mpirun -ppn 4 -np  4 ./compute_pi_mpi.exe 100000000
echo "Processes = 8"
mpirun -ppn 4 -np  8 ./compute_pi_mpi.exe 100000000
echo "Processes = 16"
mpirun -ppn 4 -np 16 ./compute_pi_mpi.exe 100000000
echo "Processes = 32"
mpirun -ppn 4 -np 32 ./compute_pi_mpi.exe 100000000
echo "Processes = 64"
mpirun -ppn 4 -np 64 ./compute_pi_mpi.exe 100000000

echo "ntasks/node = 1"
mpirun -ppn 1 -np 64 ./compute_pi_mpi.exe 10000000000
echo "ntasks/node = 2"
mpirun -ppn 2 -np 64 ./compute_pi_mpi.exe 10000000000
echo "ntasks/node = 3"
mpirun -ppn 3 -np 64 ./compute_pi_mpi.exe 10000000000
echo "ntasks/node = 4"
mpirun -ppn 4 -np 64 ./compute_pi_mpi.exe 10000000000
echo "ntasks/node = 5"
mpirun -ppn 5 -np 64 ./compute_pi_mpi.exe 10000000000
echo "ntasks/node = 6"
mpirun -ppn 6 -np 64 ./compute_pi_mpi.exe 10000000000
echo "ntasks/node = 7"
mpirun -ppn 7 -np 64 ./compute_pi_mpi.exe 10000000000
echo "ntasks/node = 8"
mpirun -ppn 8 -np 64 ./compute_pi_mpi.exe 10000000000

echo "n = 10^2"
mpirun -ppn 4 -np 64 ./compute_pi_mpi.exe 100
echo "n = 10^2, p = 1"
mpirun -ppn 4 -np 1 ./compute_pi_mpi.exe 100
echo "n = 10^4"
mpirun -ppn 4 -np 64 ./compute_pi_mpi.exe 10000
echo "n = 10^4, p = 1"
mpirun -ppn 4 -np 1 ./compute_pi_mpi.exe 10000
echo "n = 10^6"
mpirun -ppn 4 -np 64 ./compute_pi_mpi.exe 1000000
echo "n = 10^6, p = 1"
mpirun -ppn 4 -np 1 ./compute_pi_mpi.exe 1000000
echo "n = 10^8"
mpirun -ppn 4 -np 64 ./compute_pi_mpi.exe 100000000
echo "n = 10^8, p = 1"
mpirun -ppn 4 -np 1 ./compute_pi_mpi.exe 100000000
